const BOT_TOKEN = "8806433517:AAGCs1y4YDwqSMiXQoJs1Y-n0DOGDtEDbII";
const CHAT_ID = "8363306657";

// តារាងតម្លៃពេជ្រផ្លូវការ
const PRICE_LIST = {
  "100_diamonds": 0.60,
  "300_diamonds": 2.00,
  "500_diamonds": 5.00,
  "800_diamonds": 9.00,
  "1000_diamonds": 10.00,
  "10000_diamonds": 25.00,
  "monthly_pass": 13.00
};

function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    const apiKey = data.api_key;
    const game = data.game || "Free Fire";
    const pkg = data.package;
    const playerId = data.player_id;
    const zoneId = data.zone_id || "";

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const userSheet = ss.getSheetByName("Users");
    const orderSheet = ss.getSheetByName("Orders");

    // ១. ផ្ទៀងផ្ទាត់ API Key
    const userRows = userSheet.getDataRange().getValues();
    let userIndex = -1;
    let resellerName = "";
    let balance = 0;

    for (let i = 1; i < userRows.length; i++) {
      if (userRows[i][0] == apiKey) {
        userIndex = i + 1;
        resellerName = userRows[i][1];
        balance = parseFloat(userRows[i][2]);
        break;
      }
    }

    if (userIndex === -1) {
      return jsonResponse({ status: "error", message: "Invalid API Key" });
    }

    // ២. ផ្ទៀងផ្ទាត់តម្លៃកញ្ចប់ពេជ្រ
    if (!PRICE_LIST[pkg]) {
      return jsonResponse({ status: "error", message: "Invalid package name. Valid packages: " + Object.keys(PRICE_LIST).join(", ") });
    }

    const price = PRICE_LIST[pkg];

    // ៣. ពិនិត្យសមតុល្យលុយ
    if (balance < price) {
      return jsonResponse({ status: "error", message: "Insufficient balance", current_balance: balance, required: price });
    }

    // ៤. កាត់លុយក្នុង Sheets
    const newBalance = balance - price;
    userSheet.getRange(userIndex, 3).setValue(newBalance);

    // ៥. កត់ត្រា Order
    const orderId = "ORD-" + Math.floor(100000 + Math.random() * 900000);
    orderSheet.appendRow([new Date(), resellerName, game, pkg, playerId + (zoneId ? " (" + zoneId + ")" : ""), price, "PENDING"]);

    // ៦. ផ្ញើសាររោទ៍ចូល Telegram របស់អ្នកភ្លាមៗ!
    const msg = `⚡ *ការបញ្ជាទិញពី RESELLER API!* ⚡\n\n` +
                `👤 *Reseller:* ${resellerName}\n` +
                `🎮 *ហ្គេម:* ${game}\n` +
                `💎 *កញ្ចប់:* ${pkg}\n` +
                `💵 *តម្លៃកាត់:* $${price.toFixed(2)} (នៅសល់: $${newBalance.toFixed(2)})\n` +
                `🆔 *Player ID:* \`${playerId}\`\n` +
                (zoneId ? `🌐 *Zone ID:* \`${zoneId}\`\n` : '') +
                `📦 *Order ID:* \`${orderId}\``;

    UrlFetchApp.fetch("https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage", {
      method: "post",
      contentType: "application/json",
      payload: JSON.stringify({ chat_id: CHAT_ID, text: msg, parse_mode: "Markdown" })
    });

    return jsonResponse({
      status: "success",
      order_id: orderId,
      game: game,
      package: pkg,
      player_id: playerId,
      price: price,
      remaining_balance: newBalance,
      message: "Order placed successfully."
    });

  } catch (err) {
    return jsonResponse({ status: "error", message: err.toString() });
  }
}

function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
